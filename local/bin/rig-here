#!/usr/bin/env python3
"""rig-here: open tiles for the rig working in the current directory.

Reads $PWD, scans live tmux sessions for openrig seats (<pod>-<member>@<rig>),
groups them by rig, and tiles the rig whose seats run in this dir (exact match,
or longest prefix match when you're in a subdir).

If NO rig works here, it STARTS one: a per-directory instance of the jims-team
spec named jims-team-<dirname> (unique tmux session namespace — same-name
instances would collide at spawn), then tiles it.

Usage: rig-here [herdr|cmux]                    (provider default: herdr)
       rig-here <provider> --rig <name>        disambiguate when several rigs share this dir
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from collections import defaultdict

SPEC_SRC = os.path.expanduser("~/.openrig/specs/jims-team")


TRUST_MENU = "Trust all and continue"


def rig_has_live_seats(name):
    out = subprocess.run(["tmux", "list-sessions", "-F", "#{session_name}"],
                         capture_output=True, text=True).stdout
    return any(s.endswith(f"@{name}") for s in out.splitlines())


def clear_codex_trust_gates(name, wait=12):
    """Answer '2 <Enter>' on any seat pane showing the codex hook-trust menu.

    Scoped to the exact daemon-authored trust menu openrig itself intends to
    auto-clear (hook-trust-autoclear, OPR.0.4.3.33); nothing else is touched.
    """
    sessions = subprocess.run(["tmux", "list-sessions", "-F", "#{session_name}"],
                              capture_output=True, text=True).stdout.splitlines()
    cleared = []
    for s in sessions:
        if not s.endswith(f"@{name}"):
            continue
        pane = subprocess.run(["tmux", "capture-pane", "-t", s, "-p"],
                              capture_output=True, text=True).stdout
        if TRUST_MENU in pane:
            subprocess.run(["tmux", "send-keys", "-t", s, "2", "Enter"])
            cleared.append(s)
    if cleared:
        time.sleep(wait)
        print(f"rig-here: trust cleared on {len(cleared)} seat(s): "
              + ", ".join(cleared), flush=True)
        return wait
    return 0


def launch_rig_instance(name, cwd, provider):
    """Start a fresh per-directory instance of the jims-team spec."""
    tmp = tempfile.mkdtemp(prefix="rig-here-")
    shutil.copytree(SPEC_SRC, tmp, dirs_exist_ok=True)
    spec_path = os.path.join(tmp, "rig.yaml")
    src = open(spec_path).read()
    if not re.search(r"^name:", src, re.M):
        sys.exit("rig-here: spec has no top-level name field — cannot derive instance name")
    open(spec_path, "w").write(
        re.sub(r"^name:.*$", f"name: {name}", src, count=1, flags=re.M))
    print(f"rig-here: launching '{name}' ({SPEC_SRC}) in {cwd} — this takes a minute…", flush=True)
    r = subprocess.run(["rig", "up", spec_path, "--cwd", cwd],
                       capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        # A 409 import_rig 'blocked' means seats spawned but some parked in
        # attention (e.g. codex hook-trust dialogs) — recoverable, not fatal.
        blocked = "blocked" in r.stdout or "409" in r.stderr + r.stdout
        if not blocked or not rig_has_live_seats(name):
            sys.exit(f"rig-here: rig up failed for instance '{name}'")
        print("rig-here: up returned blocked — clearing codex hook-trust gates "
              "(the daemon's autoclear is broken on codex ≥0.15x, openrig #17)…", flush=True)
        clear_codex_trust_gates(name)
    subprocess.run(["rig", "ps", "--nodes", "--rig", name, "--json"],
                   capture_output=True, text=True)
    for _ in range(30):
        out = subprocess.run(["rig", "ps", "--nodes", "--rig", name, "--json"],
                             capture_output=True, text=True)
        try:
            nodes = json.loads(out.stdout or "[]")
        except Exception:
            nodes = []
        if nodes and any(n.get("startupStatus") == "ready" for n in nodes):
            break
        time.sleep(4)
    print(f"rig-here: instance '{name}' launched in {cwd}", flush=True)


def tmux(*args):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True)
    return r.stdout.strip()


def seat_cwd(session):
    return tmux("display-message", "-p", "-t", session, "#{pane_current_path}")


def main():
    provider = "herdr"
    hint = None
    args = [a for a in sys.argv[1:]]
    if "--rig" in args:
        i = args.index("--rig")
        hint = args[i + 1]
        args = args[:i] + args[i + 2:]
        if args:
            provider = args[0]
    elif args:
        provider = args[0]
    if provider not in ("herdr", "cmux"):
        sys.exit(f"rig-here: unknown provider '{provider}' (herdr|cmux)")

    cwd = os.path.realpath(os.environ.get("PWD") or os.getcwd())

    sessions = [s for s in tmux("list-sessions", "-F", "#{session_name}").splitlines() if "@" in s]
    by_rig = defaultdict(list)
    for s in sessions:
        by_rig[s.split("@", 1)[1]].append(s)

    rig_dirs = {rig: seat_cwd(seats[0]) for rig, seats in sorted(by_rig.items())}

    # match: exact, else longest-prefix (subdir of the rig's root)
    def match(path):
        if not path:
            return 0
        p = os.path.realpath(path)
        if cwd == p:
            return len(p) + 10_000
        return len(p) + 1 if cwd.startswith(p + os.sep) else 0

    scored = sorted(((match(d), rig, d) for rig, d in rig_dirs.items()), reverse=True)
    hits = [(rig, d) for score, rig, d in scored if score > 0]

    if hint:
        hits = [(r, d) for r, d in hits if r == hint] or hits

    if not hits:
        known = "\n".join(f"  {rig} → {d}" for rig, d in rig_dirs.items()) or "  (no live rig seats)"
        print(f"rig-here: no rig is working in {cwd} — starting one.", flush=True)
        if rig_dirs:
            print(f"Live rigs (elsewhere):\n{known}", flush=True)
        slug = re.sub(r"[^a-z0-9-]+", "-", os.path.basename(cwd).lower()).strip("-") or "rig"
        rig = f"jims-team-{slug}"
        launch_rig_instance(rig, cwd, provider)
    else:
        if len(hits) > 1 and not hint:
            others = ", ".join(r for r, _ in hits[1:])
            print(f"rig-here: {len(hits)} rigs share this dir ({others}); tiling '{hits[0][0]}' (override: rig-here {provider} --rig <name>)", flush=True)
        rig = hits[0][0]
        print(f"rig-here: {cwd} → rig '{rig}' ({hits[0][1]}), provider {provider}", flush=True)
    sys.stdout.flush()
    opener = {"herdr": "rig-herdr", "cmux": "rig-cmux"}[provider]
    os.execvp(opener, [opener, rig])


if __name__ == "__main__":
    main()
